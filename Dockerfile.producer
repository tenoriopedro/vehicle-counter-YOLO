FROM python:3.11.9-slim

RUN apt-get update && apt-get install ffmpeg intel-opencl-icd -y --no-install-recommends && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --locked

COPY ./src ./src

ENTRYPOINT [ "uv", "run", "vehicle-counter" ]

CMD ["--help"]